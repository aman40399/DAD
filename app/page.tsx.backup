import Image from 'next/image'
import Link from 'next/link'
import Header from '@/components/Header'
import Footer from '@/components/Footer'
import YouTubeEmbed from '@/components/YouTubeEmbed'
import Splash from '@/components/Splash'
import SkeletonArticle from '@/components/SkeletonArticle'
import { getHomepageArticles, getArticlesByCategory, getRecentArticles } from '@/lib/articles'
import { getTimeAgo, extractYouTubeVideoId } from '@/lib/utils'
import { Article } from '@/types'

export const revalidate = 0 // Always fetch fresh data
export const dynamic = 'force-dynamic' // Disable all caching

export default async function Home() {
  // Fetch articles from homepage positions (1-20)
  const homepageArticles = await getHomepageArticles()
  
  // Create a helper to get article by position
  const getByPosition = (pos: number): Article | undefined => {
    return homepageArticles.find(a => a.homepagePosition === pos)
  }
  
  // Map positions to content sections
  const breakingArticle = getByPosition(1) // Breaking News
  const heroArticle = getByPosition(2) || homepageArticles[0] // Hero Article
  const heroImageArticle = getByPosition(3) // Hero Image (optional)
  
  // Top Stories (positions 4-6)
  const topStories = [getByPosition(4), getByPosition(5), getByPosition(6)].filter(Boolean) as Article[]
  
  // Featured (positions 7-8)
  const featuredArticles = [getByPosition(7), getByPosition(8)].filter(Boolean) as Article[]
  
  // Latest News (positions 9-11)
  const latestNews = [getByPosition(9), getByPosition(10), getByPosition(11)].filter(Boolean) as Article[]
  
  // Spotlight (position 12)
  const spotlightArticle = getByPosition(12)
  
  // Editor's Picks (positions 13-16)
  const editorsPicks = [getByPosition(13), getByPosition(14), getByPosition(15), getByPosition(16)].filter(Boolean) as Article[]
  
  // Trending (positions 17-18)
  const trendingArticles = [getByPosition(17), getByPosition(18)].filter(Boolean) as Article[]
  
  // More Stories (positions 19-20)
  const moreStories = [getByPosition(19), getByPosition(20)].filter(Boolean) as Article[]
  
  // Fallback to category-based content if positions are empty
  const worldArticles = topStories.length > 0 ? topStories : await getArticlesByCategory('World')
  const techArticles = featuredArticles.length > 0 ? featuredArticles : await getArticlesByCategory('Technology')
  const businessArticles = latestNews.length > 0 ? latestNews : await getArticlesByCategory('Business')
  const sportsArticles = trendingArticles.length > 0 ? trendingArticles : await getArticlesByCategory('Sports')
  const opinionArticles = editorsPicks.length > 0 ? editorsPicks : await getArticlesByCategory('Opinion')
  const recentArticles = await getRecentArticles(6)

  return (
    <div className="relative flex min-h-screen w-full flex-col bg-white dark:bg-background-dark">
      <Splash />
      <div className="layout-container flex h-full grow flex-col">
        <div className="flex flex-1 justify-center">
          <div className="layout-content-container flex flex-col w-full flex-1">
            <Header />

            {/* Main Content */}
            <main className="px-4 md:px-10 lg:px-20 max-w-[1400px] mx-auto w-full">
              {/* Breaking News Banner */}
              {breakingArticle && (
                <div className="bg-red-600 text-white py-2 px-4 -mx-4 md:-mx-10 lg:-mx-20 mb-6 mt-4">
                  <div className="max-w-[1400px] mx-auto flex items-center gap-3">
                    <span className="font-bold text-xs uppercase tracking-wider">Breaking News</span>
                    <Link href={`/article/${breakingArticle.slug}`} className="text-sm font-sans hover:underline">
                      {breakingArticle.title}
                    </Link>
                  </div>
                </div>
              )}

              {/* Hero Section */}
              {heroArticle && (
                <div className="flex flex-col gap-6 py-6 lg:flex-row border-b-2 border-black dark:border-white pb-8 mb-8">
                  <div className="flex flex-col gap-4 lg:w-2/3 lg:pr-8 lg:border-r-2 border-neutral-300 dark:border-neutral-700">
                    <div className="flex items-center gap-2 mb-1">
                      <Link 
                        href={`/section/${heroArticle.category.toLowerCase()}`}
                        className="text-xs font-sans font-bold text-blue-600 uppercase tracking-wider hover:underline"
                      >
                        {heroArticle.category}
                      </Link>
                    </div>
                    <Link href={`/article/${heroArticle.slug}`}>
                      <h2 className="text-primary dark:text-neutral-50 text-4xl md:text-5xl font-black font-body leading-[1.1] tracking-tight hover:underline cursor-pointer">
                        {heroArticle.title}
                      </h2>
                    </Link>
                    {heroArticle.excerpt && (
                      <p className="text-neutral-700 dark:text-neutral-300 text-lg md:text-xl font-normal leading-relaxed font-body">
                        {heroArticle.excerpt}
                      </p>
                    )}
                    <div className="flex items-center gap-2 text-xs font-sans text-neutral-500 dark:text-neutral-400 uppercase tracking-wide">
                      <Link 
                        href={`/author/${heroArticle.author.toLowerCase().replace(/\s+/g, '-')}`} 
                        className="hover:underline font-semibold"
                      >
                        By {heroArticle.author}
                      </Link>
                      <span>•</span>
                      <span>{getTimeAgo(heroArticle.publishedAt)}</span>
                    </div>
                  </div>
                  {heroArticle.imageUrl && (
                    <div className="w-full lg:w-1/3">
                      <Link href={`/article/${heroArticle.slug}`}>
                        <div className="relative w-full aspect-[4/3] overflow-hidden">
                          <Image
                            src={heroArticle.imageUrl}
                            alt={heroArticle.title}
                            fill
                            className="object-cover grayscale hover:grayscale-0 transition-all cursor-pointer"
                            priority
                          />
                        </div>
                      </Link>
                      <p className="text-xs text-neutral-500 dark:text-neutral-400 font-sans mt-2 italic">
                        {heroArticle.title}
                      </p>
                    </div>
                  )}
                </div>
              )}

              {/* World News Section */}
              {worldArticles.length > 0 && (
                <div className="mb-12">
                  <div className="flex items-center justify-between mb-4">
                    <h2 className="text-primary dark:text-neutral-50 text-2xl font-black font-body leading-tight tracking-tight pb-2 border-b-4 border-black dark:border-white inline-block">
                      World News
                    </h2>
                    <Link href="/section/world" className="text-blue-600 hover:underline text-sm font-sans font-semibold">
                      See All →
                    </Link>
                  </div>
                  <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 pt-4">
                    {worldArticles.slice(0, 3).map((article) => (
                      <article key={article.id} className="flex flex-col gap-3 pb-4 border-b border-neutral-200 dark:border-neutral-700 lg:border-none hover:bg-neutral-50 dark:hover:bg-neutral-900 p-2 -mx-2 transition-colors">
                        {article.imageUrl ? (
                          <Link href={`/article/${article.slug}`}>
                            <div className="relative w-full aspect-video overflow-hidden">
                              <Image
                                src={article.imageUrl}
                                alt={article.title}
                                fill
                                className="object-cover grayscale hover:grayscale-0 transition-all"
                              />
                            </div>
                          </Link>
                        ) : (
                          <SkeletonArticle variant="card" />
                        )}
                        <div>
                          <Link href={`/article/${article.slug}`}>
                            <h3 className="text-primary dark:text-neutral-50 text-lg font-bold font-body leading-tight hover:underline mb-2">
                              {article.title}
                            </h3>
                          </Link>
                          {article.excerpt && (
                            <p className="text-neutral-600 dark:text-neutral-400 text-sm font-normal leading-normal font-body mb-2">
                              {article.excerpt}
                            </p>
                          )}
                          <Link 
                            href={`/author/${article.author.toLowerCase().replace(/\s+/g, '-')}`} 
                            className="text-xs text-neutral-500 hover:underline font-sans"
                          >
                            By {article.author}
                          </Link>
                        </div>
                      </article>
                    ))}
                  </div>
                </div>
              )}

              {/* Technology Section */}
              {techArticles.length > 0 && (
                <div className="mb-12 border-t-4 border-black dark:border-white pt-8">
                  <div className="flex items-center justify-between mb-4">
                    <h2 className="text-primary dark:text-neutral-50 text-2xl font-black font-body leading-tight tracking-tight pb-2 border-b-4 border-black dark:border-white inline-block">
                      Technology
                    </h2>
                    <Link href="/section/technology" className="text-blue-600 hover:underline text-sm font-sans font-semibold">
                      See All →
                    </Link>
                  </div>
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-8 pt-4">
                    {techArticles.slice(0, 4).map((article) => (
                      <article key={article.id} className="flex gap-4 pb-4 border-b border-neutral-200 dark:border-neutral-700">
                        {article.imageUrl && (
                          <Link href={`/article/${article.slug}`} className="flex-shrink-0">
                            <div className="relative w-32 h-32 overflow-hidden">
                              <Image
                                src={article.imageUrl}
                                alt={article.title}
                                fill
                                className="object-cover grayscale hover:grayscale-0 transition-all"
                              />
                            </div>
                          </Link>
                        )}
                        <div className="flex-1">
                          <Link href={`/article/${article.slug}`}>
                            <h3 className="text-primary dark:text-neutral-50 text-lg font-bold font-body leading-tight hover:underline mb-2">
                              {article.title}
                            </h3>
                          </Link>
                          {article.excerpt && (
                            <p className="text-neutral-600 dark:text-neutral-400 text-sm font-normal leading-normal font-body mb-2 line-clamp-2">
                              {article.excerpt}
                            </p>
                          )}
                          <Link 
                            href={`/author/${article.author.toLowerCase().replace(/\s+/g, '-')}`}
                            className="text-xs text-neutral-500 hover:underline font-sans"
                          >
                            By {article.author}
                          </Link>
                        </div>
                      </article>
                    ))}
                  </div>
                </div>
              )}

              {/* Business Section */}
              {businessArticles.length > 0 && (
                <div className="mb-12 border-t-4 border-black dark:border-white pt-8">
                  <div className="flex items-center justify-between mb-4">
                    <h2 className="text-primary dark:text-neutral-50 text-2xl font-black font-body leading-tight tracking-tight pb-2 border-b-4 border-black dark:border-white inline-block">
                      Business
                    </h2>
                    <Link href="/section/business" className="text-blue-600 hover:underline text-sm font-sans font-semibold">
                      See All →
                    </Link>
                  </div>
                  <div className="grid grid-cols-1 md:grid-cols-3 gap-8 pt-4">
                    {businessArticles.slice(0, 3).map((article) => (
                      <article key={article.id} className="border-b border-neutral-200 dark:border-neutral-700 pb-4 md:border-none">
                        <Link href={`/article/${article.slug}`}>
                          <h3 className="text-primary dark:text-neutral-50 text-lg font-bold font-body leading-tight hover:underline mb-2">
                            {article.title}
                          </h3>
                        </Link>
                        {article.excerpt && (
                          <p className="text-neutral-600 dark:text-neutral-400 text-sm font-normal leading-normal font-body mb-2">
                            {article.excerpt}
                          </p>
                        )}
                        <div className="text-xs text-neutral-500 font-sans">
                          {getTimeAgo(article.publishedAt)}
                        </div>
                      </article>
                    ))}
                  </div>
                </div>
              )}

              {/* Sports Section */}
              {sportsArticles.length > 0 && (
                <div className="mb-12 border-t-4 border-black dark:border-white pt-8">
                  <div className="flex items-center justify-between mb-4">
                    <h2 className="text-primary dark:text-neutral-50 text-2xl font-black font-body leading-tight tracking-tight pb-2 border-b-4 border-black dark:border-white inline-block">
                      Sports
                    </h2>
                    <Link href="/section/sports" className="text-blue-600 hover:underline text-sm font-sans font-semibold">
                      See All →
                    </Link>
                  </div>
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-8 pt-4">
                    {sportsArticles.slice(0, 2).map((article) => (
                      <article key={article.id} className="flex flex-col gap-3">
                        {article.imageUrl && (
                          <Link href={`/article/${article.slug}`}>
                            <div className="relative w-full aspect-video overflow-hidden">
                              <Image
                                src={article.imageUrl}
                                alt={article.title}
                                fill
                                className="object-cover grayscale hover:grayscale-0 transition-all"
                              />
                            </div>
                          </Link>
                        )}
                        <Link href={`/article/${article.slug}`}>
                          <h3 className="text-primary dark:text-neutral-50 text-xl font-bold font-body leading-tight hover:underline mb-2">
                            {article.title}
                          </h3>
                        </Link>
                        {article.excerpt && (
                          <p className="text-neutral-600 dark:text-neutral-400 text-sm font-normal leading-normal font-body">
                            {article.excerpt}
                          </p>
                        )}
                        <Link 
                          href={`/author/${article.author.toLowerCase().replace(/\s+/g, '-')}`}
                          className="text-xs text-neutral-500 hover:underline font-sans"
                        >
                          By {article.author}
                        </Link>
                      </article>
                    ))}
                  </div>
                </div>
              )}

              {/* Opinion Section */}
              {opinionArticles.length > 0 && (
                <div className="mb-12 border-t-4 border-black dark:border-white pt-8">
                  <div className="flex items-center justify-between mb-4">
                    <h2 className="text-primary dark:text-neutral-50 text-2xl font-black font-body leading-tight tracking-tight pb-2 border-b-4 border-black dark:border-white inline-block">
                      Opinion
                    </h2>
                    <Link href="/section/opinion" className="text-blue-600 hover:underline text-sm font-sans font-semibold">
                      See All →
                    </Link>
                  </div>
                  <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 pt-4">
                    {opinionArticles.slice(0, 3).map((article) => (
                      <article key={article.id} className="border-l-4 border-blue-600 pl-4">
                        <Link href={`/article/${article.slug}`}>
                          <h3 className="text-primary dark:text-neutral-50 text-lg font-bold font-body leading-tight hover:underline mb-2">
                            {article.title}
                          </h3>
                        </Link>
                        {article.excerpt && (
                          <p className="text-neutral-600 dark:text-neutral-400 text-sm font-normal leading-normal font-body mb-2">
                            {article.excerpt}
                          </p>
                        )}
                        <Link 
                          href={`/author/${article.author.toLowerCase().replace(/\s+/g, '-')}`}
                          className="text-xs text-neutral-500 hover:underline font-sans font-semibold"
                        >
                          {article.author}
                        </Link>
                      </article>
                    ))}
                  </div>
                </div>
              )}

              {/* Latest Articles */}
              {recentArticles.length > 0 && (
                <div className="mb-12 border-t-4 border-black dark:border-white pt-8">
                  <h2 className="text-primary dark:text-neutral-50 text-2xl font-black font-body leading-tight tracking-tight pb-2 border-b-4 border-black dark:border-white inline-block mb-6">
                    Latest Stories
                  </h2>
                  <div className="space-y-4">
                    {recentArticles.slice(0, 5).map((article, index) => (
                      <article 
                        key={article.id} 
                        className="flex gap-4 pb-4 border-b border-neutral-200 dark:border-neutral-700 last:border-none"
                      >
                        <div className="flex-shrink-0 text-3xl font-black font-playfair text-neutral-300 dark:text-neutral-700 w-12">
                          {(index + 1).toString().padStart(2, '0')}
                        </div>
                        <div className="flex-1">
                          <div className="mb-1">
                            <Link 
                              href={`/section/${article.category.toLowerCase()}`}
                              className="text-xs font-bold uppercase tracking-wider text-blue-600 hover:underline"
                            >
                              {article.category}
                            </Link>
                          </div>
                          <Link href={`/article/${article.slug}`}>
                            <h3 className="text-primary dark:text-neutral-50 text-lg font-bold font-body leading-tight hover:underline mb-1">
                              {article.title}
                            </h3>
                          </Link>
                          <div className="text-xs text-neutral-500 font-sans">
                            {article.author} • {getTimeAgo(article.publishedAt)}
                          </div>
                        </div>
                      </article>
                    ))}
                  </div>
                </div>
              )}
            </main>

            <Footer />
          </div>
        </div>
      </div>
    </div>
  )
}
